{
  "name": "jev-hermes",
  "version": "0.1.0",
  "description": "A resident Pi agent whose model, skills, permissions, memory and orchestration are all decided by Jev, on one request per turn and one shared budget.",
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "jev", "typesafe", "agent", "resident"],
  "main": "./src/turn.ts",
  "exports": { ".": "./src/turn.ts", "./pi": "./src/pi.ts", "./budget": "./src/budget.js", "./tiers": "./src/tiers.js" },
  "bin": { "jev-hermes": "./src/cli.ts" },
  "pi": { "extensions": ["./src/pi.ts"] },
  "files": ["src", "README.md"],
  "engines": { "node": ">=22.19.0" },
  "scripts": { "test": "tsx test.ts" },
  "dependencies": {
    "@jev-playground/jev-core": "*",
    "jev-compact": "*",
    "jev-guard": "*",
    "jev-model-router": "*",
    "jev-orchestrator": "*",
    "jev-skill-router": "*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
