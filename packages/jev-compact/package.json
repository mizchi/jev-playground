{
  "name": "jev-compact",
  "version": "0.1.0",
  "description": "Compact an agent's context by deleting spent entries rather than summarising them. Jev ranks, code enforces the structure.",
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "jev", "typesafe", "compaction", "context"],
  "main": "./src/compact.ts",
  "exports": { ".": "./src/compact.ts", "./pi": "./src/pi.ts" },
  "bin": { "jev-compact": "./src/cli.ts" },
  "pi": { "extensions": ["./src/pi.ts"] },
  "files": ["src", "README.md"],
  "engines": { "node": ">=22.19.0" },
  "scripts": { "test": "tsx test.ts" },
  "dependencies": { "@jev-playground/jev-core": "*" },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
