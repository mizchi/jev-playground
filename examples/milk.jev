# 冷蔵庫と財布の中身。すべての judgment がこの state を見る。
# state は 1 リクエストに 1 回しか乗らないので、質問を足すコストは質問文だけ。
state {
  fridge: ["卵", "ビール", "マヨネーズ"],
  wallet_yen: 100,
  wife_mood: "ふつう",
  day: "金曜日",
}

# 閾値は質問ではなくコード側に置く(docs/01 §3)。
# 質問を書き換えずに厳しめ・緩めを切り替えられる。
threshold noul = 0.5
threshold gate = 0.5

if noul("家に牛乳がない") {
  buy("牛乳")
}

# choice は必ず選択肢の 1 つを返す(閉じた世界)。else 腕を書くと
# 「どれも当てはまらない」を聞く gate noul が別の質問として増える ——
# 選択肢に「該当なし」を混ぜるより強い、というのが docs/13 の実測。
# 3 択すべてに腕があるので、else に来るのは gate が落ちたときだけ。
let result = match choice("100円余ったときに買うもの", ["プリン", "ビール", "うまい棒"]) {
  "プリン" => buy("プリン")
  "ビール" => buy("ビール")
  "うまい棒" => buy("うまい棒")
  else => buy("牛乳")
}

# ここだけは質問文が実行時の値に依存するので、バッチに載せられない。
# 上の 3 問(noul + choice + gate)は 1 リクエスト、この 1 問が 2 本目。
let praised = score("${result} を買ったことで妻に褒められる確率", [
  "褒められない",
  "何も言われない",
  "褒められる",
])

if praised >= 1.5 {
  say("よくやった")
} else {
  say("${result} は失敗だったかもしれない")
}
