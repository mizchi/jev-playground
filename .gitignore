_build/
.mooncakes/
.openseek/
.DS_Store
node_modules/
experiments/*/out/
experiments/*/out-*.log
hooks/out-*.log
hooks/out-*.jsonl
.claude/jev-gate.json
experiments/*/.jev-quality*.json
# Playwright run artifacts from the generated specs (docs/59).
experiments/*/test-results/
# Per-trial output from `run-testgen.ts --repeat N` (docs/59). Regenerable,
# and committing whichever trials happen to exist mid-sweep is worse than
# committing none. The single-trial output above it stays tracked as the
# example docs/59 quotes.
experiments/*/generated/trial-*/

packages/node_modules/
packages/*/node_modules/

# docs/38's harness writes these: the skills it hands pi, and pi's own caches.
experiments/agent/skills/

# The keyless `--worlds` runs (docs/50, docs/51) write here rather than over
# the scored record, so their null answers never replace the numbers the
# reports are made from.
experiments/*/records/*-worlds.json
