{
  "name": "eslint-plugin-jev",
  "private": true,
  "version": "0.1.0",
  "description": "An ESLint rule whose verdict comes from Jev: a per-function review score and named review criteria, batched (docs/21, docs/22)",
  "type": "module",
  "exports": "./src/index.mjs",
  "bin": { "jev-warm": "./src/warm.mjs" },
  "scripts": {
    "test": "node experiment/test.mjs",
    "truth": "node experiment/truth.mjs",
    "warm": "node src/warm.mjs \"experiment/corpus/*.js\"",
    "lint": "eslint --config experiment/eslint.config.mjs experiment/corpus",
    "run": "node experiment/run.mjs",
    "replay": "node experiment/run.mjs --from experiment/out-run.json",
    "criteria": "node experiment/run-criteria.mjs",
    "replay:criteria": "node experiment/run-criteria.mjs --from experiment/out-criteria.json",
    "bench": "node experiment/sync-bench.mjs",
    "replay:tiers": "node experiment/run-criteria.mjs --from experiment/out-criteria-tiers.json",
    "loo": "node experiment/run-loo.mjs",
    "replay:loo": "node experiment/run-loo.mjs --from experiment/out-loo.json"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "eslint": "^9.36.0"
  }
}
